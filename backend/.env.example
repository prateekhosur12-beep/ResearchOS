# ============ Language model (Ollama, local) ============
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
# Embeddings are a SEPARATE model: a chat model does not emit vectors.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Set to 0 to force the deterministic local lexical embedding (no Ollama needed)
OLLAMA_EMBED_ENABLED=1

# ============ Storage ============
# SQLite by default. Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/research
DATABASE_URL=sqlite+aiosqlite:///./data/research.db
DATA_DIR=./data
EXPORT_DIR=./exports

# ============ Scholarly sources ============
# A real contact address is polite-pool practice for OpenAlex/Crossref.
SCHOLARLY_CONTACT_EMAIL=student@example.edu
OPENALEX_BASE_URL=https://api.openalex.org
CROSSREF_BASE_URL=https://api.crossref.org
ARXIV_BASE_URL=https://export.arxiv.org/api
SCHOLARLY_TIMEOUT=25
SCHOLARLY_MAX_RETRIES=2
SCHOLARLY_CONCURRENCY=4

# ============ Workflow policy ============
MIN_PAPERS_FOR_ANALYSIS=5
DEFAULT_RESULT_LIMIT=20
MAX_RESULT_LIMIT=50
MAX_DISCOVERY_ATTEMPTS=3          # bounded plan-act-observe-revise loop (Lab 1)
MAX_GRAPH_REVISIONS=2             # bounded conditional re-routing (Lab 7)
SEARCH_CACHE_TTL_SECONDS=86400
REQUIRE_APPROVAL_BEFORE_EXPORT=1

# ============ MCP tool connector ============
# 1 = tools are executed through a real MCP stdio server (Lab 5)
# 0 = direct in-process tool registry (same registry, no protocol hop)
MCP_ENABLED=1
MCP_SERVER_MODULE=app.mcp.server
MCP_CALL_TIMEOUT=90

# ============ Server ============
# For the sandbox/preview proxy, keep 0.0.0.0 and permissive origins.
CORS_ORIGINS=*
LOG_LEVEL=INFO
DEMO_MODE=0                       # 1 = explicit, clearly-labelled synthetic mode (tests only)
